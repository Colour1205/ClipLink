# Build output
bin/
obj/
# windows/publish.ps1 output (the app folder and the installer) and the
# Inno Setup compiler it fetches
windows/dist/
windows/.tools/

# VS / VS Code
.vs/
*.user
*.suo

# Rider
.idea/

# OS junk
Thumbs.db
.DS_Store

# NuGet
*.nupkg
**/packages/*

# Logs and scratch files created while testing this project locally
*.log
mobile/harmonyos/.codegenie/

# iOS / Xcode
mobile/ios/**/.build/
mobile/ios/**/xcuserdata/
mobile/ios/**/*.xcuserstate
mobile/ios/**/DerivedData/
/mobile/android/ClipLink/app/release

# ---------------------------------------------------------------------------
# Secrets and signing material. These must never reach the repository: an
# Android upload key, an Apple provisioning profile or a Windows code-signing
# certificate cannot be un-leaked once pushed, and ClipLink's own identity
# and passcode keys are *.key files.
*.jks
*.keystore
*.p12
*.pfx
*.p8
*.pem
*.key
*.cer
*.mobileprovision
*.provisionprofile
.env
.env.*
!.env.example
local.properties

# Built packages and archives (the build scripts put these in dist/ or outside
# the tree; this stops a copy that wandered in from being committed)
*.apk
*.aab
*.hap
*.hsp
*.ipa
*.xcarchive
*.dSYM/
*.dSYM.zip
*.msix
*.appx

# Build and tool output
build/
.kotlin/
.swiftpm/
Pods/
TestResults/
*.binlog
__pycache__/
*.pyc
*.hprof

# Claude Code: per-machine settings and its git worktrees
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# OneDrive / editors / merge leftovers (this repo lives in a synced folder)
desktop.ini
~$*
*.tmp
*.bak
*.orig
*.rej
*.swp

# Raw Google Drive downloads (design assets and the like): import what is
# needed into the app, don't commit the download folder
drive-download-*/
