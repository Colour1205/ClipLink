<Page x:Class="ClipLink.SyncedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ClipLink"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      NavigationCacheMode="Required"
      PointerPressed="Page_PointerPressed">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="Back_Invoked" />
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Back_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!-- ==== What's inside a card, by kind: list view ==== -->
        <DataTemplate x:Key="TextContent" x:DataType="local:HistoryCard">
            <TextBlock Text="{x:Bind PreviewText, Mode=OneWay}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="4" />
        </DataTemplate>

        <DataTemplate x:Key="ImageContent" x:DataType="local:HistoryCard">
            <StackPanel>
                <Grid HorizontalAlignment="Left">
                    <!-- Rounded corners: the image is the border's background. -->
                    <Border Width="{x:Bind ThumbnailWidth, Mode=OneWay}" Height="{x:Bind ThumbnailHeight, Mode=OneWay}"
                            CornerRadius="4" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Visibility="{x:Bind HasThumbnail, Mode=OneWay}">
                        <Border.Background>
                            <ImageBrush ImageSource="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <!-- While an image is decoding, or if it can't be. -->
                    <Border Width="160" Height="90" CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="{x:Bind NoThumbnail, Mode=OneWay}">
                        <SymbolIcon Symbol="{x:Bind PlaceholderSymbol, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Border>
                </Grid>
                <TextBlock Text="{x:Bind ImageDetail, Mode=OneWay}" Style="{StaticResource CaptionSecondary}" Margin="0,8,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FileContent" x:DataType="local:HistoryCard">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="4" VerticalAlignment="Top"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <SymbolIcon Symbol="Document" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind FileName, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind FileDetail, Mode=OneWay}" Style="{StaticResource CaptionSecondary}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <local:HistoryContentSelector x:Key="ContentSelector"
                                      TextTemplate="{StaticResource TextContent}"
                                      ImageTemplate="{StaticResource ImageContent}"
                                      FileTemplate="{StaticResource FileContent}" />

        <!-- ==== ... grid view: more text, the image across the card ==== -->
        <DataTemplate x:Key="GridTextContent" x:DataType="local:HistoryCard">
            <TextBlock Text="{x:Bind GridPreviewText, Mode=OneWay}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="10" />
        </DataTemplate>

        <DataTemplate x:Key="GridImageContent" x:DataType="local:HistoryCard">
            <Grid>
                <!-- As wide as the card, as high as the image (a very tall
                     one cropped at 320). -->
                <Border CornerRadius="4" BorderThickness="1" MaxHeight="320"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Visibility="{x:Bind HasThumbnail, Mode=OneWay}"
                        SizeChanged="GridThumb_SizeChanged">
                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                </Border>
                <Border Height="120" CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Visibility="{x:Bind NoThumbnail, Mode=OneWay}">
                    <SymbolIcon Symbol="{x:Bind PlaceholderSymbol, Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GridFileContent" x:DataType="local:HistoryCard">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="4" VerticalAlignment="Top"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <SymbolIcon Symbol="Document" />
                </Border>
                <!-- A narrow card: the name gets two lines. -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                               ToolTipService.ToolTip="{x:Bind FileName, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind FileDetail, Mode=OneWay}" Style="{StaticResource CaptionSecondary}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <local:HistoryContentSelector x:Key="GridContentSelector"
                                      TextTemplate="{StaticResource GridTextContent}"
                                      ImageTemplate="{StaticResource GridImageContent}"
                                      FileTemplate="{StaticResource GridFileContent}" />

        <!-- A card's Copy / Open / Delete buttons (the same in both views). -->
        <DataTemplate x:Key="CardActions" x:DataType="local:HistoryCard">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Style="{StaticResource IconButton}"
                        ToolTipService.ToolTip="Copy to this PC's clipboard" AutomationProperties.Name="Copy"
                        Visibility="{x:Bind CanCopy, Mode=OneWay}"
                        Click="Copy_Click">
                    <SymbolIcon Symbol="Copy" />
                </Button>
                <Button Style="{StaticResource IconButton}"
                        ToolTipService.ToolTip="Open" AutomationProperties.Name="Open"
                        Visibility="{x:Bind CanOpen, Mode=OneWay}"
                        Click="Open_Click">
                    <SymbolIcon Symbol="OpenFile" />
                </Button>
                <Button Style="{StaticResource IconButton}"
                        ToolTipService.ToolTip="Delete" AutomationProperties.Name="Delete"
                        Click="Delete_Click">
                    <SymbolIcon Symbol="Delete" />
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- ==== A card ==== -->
        <!-- List: what it is, when, where from, and the buttons along the
             top; the content under them. -->
        <DataTemplate x:Key="ListCard" x:DataType="local:HistoryCard">
            <ItemContainer CornerRadius="4" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
            <Border Style="{StaticResource CardBorder}" Padding="16,10,8,14"
                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- The device last: a long name is what gets cut short, never the time. -->
                        <SymbolIcon Symbol="{x:Bind KindSymbol, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionSecondary}"
                                   Text="{x:Bind Summary, Mode=OneWay}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind Origin, Mode=OneWay}" />
                        <ContentControl Grid.Column="2" Margin="8,0,0,0" Content="{x:Bind}"
                                        ContentTemplate="{StaticResource CardActions}"
                                        HorizontalContentAlignment="Stretch" IsTabStop="False" />

                        <ContentControl Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,8,0"
                                        Content="{x:Bind}"
                                        ContentTemplateSelector="{StaticResource ContentSelector}"
                                        HorizontalContentAlignment="Stretch" IsTabStop="False" />
                    </Grid>
                </Border>
            </ItemContainer>
        </DataTemplate>

        <!-- Grid: the content first (a card's job is showing it), then when
             and where from, and the buttons, along the bottom. -->
        <DataTemplate x:Key="GridCard" x:DataType="local:HistoryCard">
            <ItemContainer CornerRadius="4" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
            <Border Style="{StaticResource CardBorder}" Padding="12,12,6,6"
                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentControl Grid.ColumnSpan="3" Margin="0,0,6,6"
                                        Content="{x:Bind}"
                                        ContentTemplateSelector="{StaticResource GridContentSelector}"
                                        HorizontalContentAlignment="Stretch" IsTabStop="False" />

                        <SymbolIcon Grid.Row="1" Symbol="{x:Bind KindSymbol, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    ToolTipService.ToolTip="{x:Bind KindText, Mode=OneWay}"
                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                        <!-- When over where from: a narrow card has no room for both on one line. -->
                        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{x:Bind Origin, Mode=OneWay}">
                            <TextBlock Text="{x:Bind When, Mode=OneWay}" Style="{StaticResource CaptionSecondary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Source, Mode=OneWay}" Style="{StaticResource CaptionSecondary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ContentControl Grid.Row="1" Grid.Column="2" Margin="4,0,0,0" Content="{x:Bind}"
                                        ContentTemplate="{StaticResource CardActions}"
                                        HorizontalContentAlignment="Stretch" IsTabStop="False" />
                    </Grid>
                </Border>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: stays put while the list scrolls. -->
        <Grid Margin="{StaticResource PageMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMaxWidth}" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ListTitle" Text="Synced" Style="{StaticResource TitleTextBlockStyle}" />
                    <!-- One item in full: "Synced > Text", Synced going back. -->
                    <BreadcrumbBar x:Name="DetailTitle" Style="{StaticResource PageBreadcrumb}" Visibility="Collapsed" ItemClicked="DetailTitle_ItemClicked" />

                    <!-- List or grid, as on the phones. -->
                    <controls:Segmented x:Name="ViewSwitch" Grid.Column="1" SelectionMode="Single"
                                        VerticalAlignment="Center" Margin="12,0,0,0"
                                        AutomationProperties.Name="View"
                                        SelectionChanged="ViewSwitch_SelectionChanged">
                        <controls:SegmentedItem ToolTipService.ToolTip="List view" AutomationProperties.Name="List view">
                            <controls:SegmentedItem.Icon>
                                <FontIcon Glyph="&#xE8FD;" />
                            </controls:SegmentedItem.Icon>
                        </controls:SegmentedItem>
                        <controls:SegmentedItem ToolTipService.ToolTip="Grid view" AutomationProperties.Name="Grid view">
                            <controls:SegmentedItem.Icon>
                                <FontIcon Glyph="&#xF0E2;" />
                            </controls:SegmentedItem.Icon>
                        </controls:SegmentedItem>
                    </controls:Segmented>
                </Grid>
                <TextBlock x:Name="ListSubtitle" Text="{x:Bind host.ConnectionSummary, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                <TextBlock x:Name="DetailOrigin" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"
                           Visibility="Collapsed" />
                <InfoBar x:Name="StatusBanner" Margin="0,12,0,0" />
                <!-- First run without a passcode: a nudge, not a nag (closable). -->
                <InfoBar x:Name="PasscodeTip" IsOpen="False" IsClosable="True" Severity="Informational" Margin="0,12,0,0"
                         Title="Set a passcode"
                         Message="Your devices with the same passcode pair with each other automatically - no code to scan."
                         CloseButtonClick="PasscodeTip_Closed">
                    <InfoBar.ActionButton>
                        <Button Content="Set passcode" Click="PasscodeTip_Action" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
        </Grid>

        <!-- A ListBox-like view of the cards: each takes keyboard focus (arrow
             keys between cards, Enter shows it in full, Shift+F10 its menu)
             and screen readers get a real list of items. Its layout and card
             template (list or grid) are set in code. -->
        <ItemsView x:Name="Cards" Grid.Row="1"
                   Padding="36,12,36,32"
                   SelectionMode="None"
                   IsItemInvokedEnabled="True"
                   ItemInvoked="Cards_ItemInvoked"
                   ContextRequested="Cards_ContextRequested"
                   AutomationProperties.Name="Synced items" />

        <!-- Nothing yet. -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" Visibility="{x:Bind host.HistoryIsEmpty, Mode=OneWay}"
                    HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="380" Margin="0,56,0,0">
            <SymbolIcon Symbol="Paste" HorizontalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                <SymbolIcon.RenderTransform>
                    <ScaleTransform ScaleX="2.4" ScaleY="2.4" />
                </SymbolIcon.RenderTransform>
            </SymbolIcon>
            <TextBlock Text="Nothing synced yet" Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" Margin="0,24,0,4" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Copy something on this PC or on one of your paired devices, and it shows up here." />
        </StackPanel>

        <!-- One item in full - the phones' item screen: all of the text
             (selectable), the image as big as fits, and every action. -->
        <ScrollViewer x:Name="DetailView" Grid.Row="1" Visibility="Collapsed" SizeChanged="DetailView_SizeChanged">
            <Grid Margin="{StaticResource PageContentMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMaxWidth}" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <controls:WrapPanel Orientation="Horizontal" HorizontalSpacing="8" VerticalSpacing="8">
                        <Button x:Name="DetailCopy" Style="{StaticResource AccentButtonStyle}" MinWidth="96"
                                ToolTipService.ToolTip="Copy to this PC's clipboard" Click="DetailCopy_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Copy" />
                                <TextBlock Text="Copy" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DetailOpen" MinWidth="96" Click="DetailOpen_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="Open" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DetailShowInFolder" Click="DetailShowInFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Folder" />
                                <TextBlock Text="Show in folder" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DetailDelete" MinWidth="96" Click="DetailDelete_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="Delete" />
                            </StackPanel>
                        </Button>
                    </controls:WrapPanel>

                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                        <Grid>
                            <!-- Plain read-only text: select some of it, or Copy for all. -->
                            <TextBlock x:Name="DetailText"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       AutomationProperties.Name="Text"
                                       Visibility="Collapsed" />
                            <Image x:Name="DetailImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center" MaxHeight="640"
                                   AutomationProperties.Name="Synced image"
                                   Visibility="Collapsed" />
                            <ContentControl x:Name="DetailFile"
                                            ContentTemplate="{StaticResource FileContent}"
                                            HorizontalContentAlignment="Stretch" IsTabStop="False"
                                            Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="DetailFacts" Style="{StaticResource CaptionSecondary}" TextWrapping="Wrap" Margin="1,8,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
