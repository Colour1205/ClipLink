<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for ClipLink\CollectionSync.cs, the code that keeps the
       Synced and Devices pages' lists in step with the engine. Run with
       `dotnet test windows\ClipLink.ReconcileTests`. ClipLink.csproj is a
       WinUI exe, which a test project can't sensibly reference, so the file
       is linked in instead - which is also why it must stay free of WinUI. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ClipLink.ReconcileTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ClipLink\CollectionSync.cs" Link="CollectionSync.cs" />
  </ItemGroup>

</Project>
