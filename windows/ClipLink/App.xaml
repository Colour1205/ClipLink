<Application x:Class="ClipLink.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ClipLink"
             ShutdownMode="OnExplicitShutdown">
    <!-- No StartupUri: App.OnStartup decides (the window may start hidden in
         the tray). OnExplicitShutdown: closing the window only hides it -
         only Settings > Quit ends the app. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Initial theme; App switches it to match Windows (and
                     SystemThemeWatcher keeps it matching). -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Wpf.Ui defaults to "Segoe UI"; Windows 11 uses Segoe UI
                 Variable. WPF doesn't switch its optical size by itself, so
                 Text for body sizes and Display for titles (20 px and up). -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

            <BooleanToVisibilityConverter x:Key="VisibleIf" />
            <local:VisibleIfNotConverter x:Key="VisibleIfNot" />
            <local:VisibleIfSetConverter x:Key="VisibleIfSet" />

            <!-- The Fluent type ramp (size / line height). -->
            <Style x:Key="CaptionText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="20" />
            </Style>
            <Style x:Key="BodyStrongText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SubtitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="LineHeight" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="TitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="LineHeight" Value="36" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <!-- A group of cards' heading, as in Windows Settings. -->
            <Style x:Key="SectionHeaderText" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongText}">
                <Setter Property="Margin" Value="1,24,0,8" />
            </Style>

            <!-- A card on the Mica background. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Settings rows (SettingsCard.cs). -->
            <Style TargetType="local:SettingsCard">
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:SettingsCard">
                            <Border Style="{StaticResource Card}" Padding="16,12,16,12" MinHeight="68">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ui:SymbolIcon Symbol="{TemplateBinding Icon}" FontSize="20"
                                                   VerticalAlignment="Center" Margin="4,0,20,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                        <TextBlock Text="{TemplateBinding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                   Visibility="{TemplateBinding Description, Converter={StaticResource VisibleIfSet}}" />
                                    </StackPanel>
                                    <ContentPresenter x:Name="Presenter" Grid.Column="2"
                                                      VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsNarrow" Value="True">
                                    <Setter TargetName="Presenter" Property="Grid.Row" Value="1" />
                                    <Setter TargetName="Presenter" Property="Grid.Column" Value="1" />
                                    <Setter TargetName="Presenter" Property="Grid.ColumnSpan" Value="2" />
                                    <Setter TargetName="Presenter" Property="HorizontalAlignment" Value="Left" />
                                    <Setter TargetName="Presenter" Property="Margin" Value="0,12,0,0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Square icon-only button (give it AutomationProperties.Name and a ToolTip). -->
            <Style x:Key="IconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <!-- Page content (36 px in from the sides): at most this wide,
                 left-aligned as in Windows Settings. -->
            <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="PageMaxWidth">1000</system:Double>

        </ResourceDictionary>
    </Application.Resources>
</Application>
