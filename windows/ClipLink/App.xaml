<Application x:Class="ClipLink.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No window is created here: App.OnLaunched decides (the window may
         start hidden in the tray, and closing it only hides it). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Page content (36 px in from the sides): at most this wide,
                 left-aligned as in Windows Settings. -->
            <x:Double x:Key="PageMaxWidth">1000</x:Double>
            <Thickness x:Key="PageMargin">36,12,36,0</Thickness>
            <Thickness x:Key="PageContentMargin">36,0,36,32</Thickness>

            <!-- A card on the Mica background. -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- A group of cards' heading, as in Windows Settings. -->
            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,24,0,8" />
            </Style>

            <!-- Small grey text under a title. -->
            <Style x:Key="CaptionSecondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- The page title as a breadcrumb ("Synced > Text"): the same size
                 and weight as the plain title on the list, not the control's
                 small default text. -->
            <DataTemplate x:Key="PageBreadcrumbItem">
                <TextBlock Text="{Binding}" Style="{StaticResource TitleTextBlockStyle}" />
            </DataTemplate>
            <Style x:Key="PageBreadcrumb" TargetType="BreadcrumbBar">
                <Setter Property="ItemTemplate" Value="{StaticResource PageBreadcrumbItem}" />
            </Style>
            <x:Double x:Key="BreadcrumbBarChevronFontSize">16</x:Double>

            <!-- Square icon-only button (give it AutomationProperties.Name and a ToolTip). -->
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
