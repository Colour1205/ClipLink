<Page x:Class="ClipLink.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:ClipLink"
      Title="Settings"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{DynamicResource ContentControlThemeFontFamily}"
      ScrollViewer.CanContentScroll="False">
    <!-- CanContentScroll False: NavigationView doesn't wrap the page in a
         ScrollViewer of its own - the header stays put and only the
         content below it scrolls. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="36,12,36,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMaxWidth}" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource TitleText}" />
                <local:Banner x:Name="StatusBanner" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="36,0,36,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMaxWidth}" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <!-- This PC -->
                    <TextBlock Text="This PC" Style="{StaticResource SectionHeaderText}" Margin="1,12,0,8" />
                    <local:SettingsCard Icon="Rename24" Header="Device name" NarrowWidth="640"
                                        Description="How this PC appears on your other devices. Leave it empty to use the computer's name.">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox x:Name="DeviceNameBox" Width="220" MaxLength="64"
                                        AutomationProperties.Name="Device name"
                                        KeyDown="DeviceNameBox_KeyDown" />
                            <ui:Button Content="Save" Margin="8,0,0,0" MinWidth="72" Click="SaveName_Click" />
                        </StackPanel>
                    </local:SettingsCard>
                    <local:SettingsCard x:Name="DeviceIdCard" Icon="Fingerprint24" Header="Device ID" NarrowWidth="420">
                        <ui:Button Content="Copy" Icon="{ui:SymbolIcon Copy24}" MinWidth="88"
                                   AutomationProperties.Name="Copy device ID" Click="CopyId_Click" />
                    </local:SettingsCard>
                    <local:SettingsCard x:Name="TailscaleCard" Icon="Globe24" Header="Tailscale address" NarrowWidth="420"
                                        Visibility="Collapsed">
                        <ui:Button Content="Copy" Icon="{ui:SymbolIcon Copy24}" MinWidth="88"
                                   AutomationProperties.Name="Copy Tailscale address" Click="CopyTailscale_Click" />
                    </local:SettingsCard>

                    <!-- Pairing (the phones' "Shared passcode") -->
                    <TextBlock Text="Pairing" Style="{StaticResource SectionHeaderText}" />
                    <local:SettingsCard x:Name="PasscodeCard" Icon="Password24" Header="Passcode" NarrowWidth="760">
                        <StackPanel Orientation="Horizontal">
                            <ui:PasswordBox x:Name="PasscodeBox" Width="200"
                                            PlaceholderText="New passcode"
                                            AutomationProperties.Name="New passcode"
                                            KeyDown="PasscodeBox_KeyDown" />
                            <ui:Button x:Name="SetPasscodeButton" Content="Set" Appearance="Primary" MinWidth="72"
                                       Margin="8,0,0,0" Click="SetPasscode_Click" />
                            <ui:Button x:Name="ClearPasscodeButton" Content="Clear" MinWidth="72"
                                       Margin="8,0,0,0" Click="ClearPasscode_Click" />
                        </StackPanel>
                    </local:SettingsCard>
                    <StackPanel x:Name="PasscodeBusy" Orientation="Horizontal" Margin="1,4,0,4" Visibility="Collapsed">
                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" />
                        <TextBlock Text="Saving the passcode..." Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="PasscodeError" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Margin="1,4,0,4" Visibility="Collapsed" />

                    <!-- General -->
                    <TextBlock Text="General" Style="{StaticResource SectionHeaderText}" />
                    <local:SettingsCard Icon="Power24" Header="Start ClipLink when I sign in" NarrowWidth="420"
                                        Description="It starts in the notification area, so your devices stay in sync.">
                        <!-- On/Off beside it, as in Windows Settings. -->
                        <ui:ToggleSwitch x:Name="SignInToggle"
                                         OnContent="On" OffContent="Off" LabelPosition="Left"
                                         AutomationProperties.Name="Start ClipLink when I sign in"
                                         Checked="SignInToggle_Changed" Unchecked="SignInToggle_Changed" />
                    </local:SettingsCard>

                    <!-- Synced history -->
                    <TextBlock Text="Synced history" Style="{StaticResource SectionHeaderText}" />
                    <local:SettingsCard Icon="Delete24" Header="Clear synced history" NarrowWidth="480"
                                        Description="Deletes every synced item from this PC. They won't come back from your other devices, which keep their own copies.">
                        <ui:Button Content="Clear" MinWidth="88" AutomationProperties.Name="Clear synced history"
                                   Click="ClearHistory_Click" />
                    </local:SettingsCard>

                    <!-- About -->
                    <TextBlock Text="About" Style="{StaticResource SectionHeaderText}" />
                    <local:SettingsCard x:Name="AboutCard" Icon="Info24" Header="ClipLink" NarrowWidth="480">
                        <ui:Button Content="Open log folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="OpenLogs_Click" />
                    </local:SettingsCard>
                    <local:SettingsCard Icon="ArrowExit20" Header="Quit ClipLink" NarrowWidth="480"
                                        Description="Stops syncing until ClipLink starts again. Closing the window keeps it running in the notification area.">
                        <ui:Button Content="Quit" MinWidth="88" AutomationProperties.Name="Quit ClipLink" Click="Quit_Click" />
                    </local:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
