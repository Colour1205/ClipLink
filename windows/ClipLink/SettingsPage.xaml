<Page x:Class="ClipLink.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      NavigationCacheMode="Required">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: stays put while the cards scroll. -->
        <Grid Margin="{StaticResource PageMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMaxWidth}" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                <InfoBar x:Name="StatusBanner" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1">
            <Grid Margin="{StaticResource PageContentMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMaxWidth}" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <!-- This PC -->
                    <TextBlock Text="This PC" Style="{StaticResource SectionHeader}" Margin="1,12,0,4" />
                    <controls:SettingsCard Header="Device name"
                                           Description="How this PC appears on your other devices. Leave it empty to use the computer's name.">
                        <controls:SettingsCard.HeaderIcon>
                            <SymbolIcon Symbol="Rename" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="DeviceNameBox" Width="220" MaxLength="64"
                                     AutomationProperties.Name="Device name"
                                     KeyDown="DeviceNameBox_KeyDown" />
                            <Button Content="Save" MinWidth="72" Click="SaveName_Click" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="DeviceIdCard" Header="Device ID">
                        <controls:SettingsCard.HeaderIcon>
                            <SymbolIcon Symbol="Permissions" />
                        </controls:SettingsCard.HeaderIcon>
                        <Button Content="Copy" MinWidth="88" AutomationProperties.Name="Copy device ID" Click="CopyId_Click" />
                    </controls:SettingsCard>
                    <!-- The short form of the device ID that pairing prompts show -->
                    <controls:SettingsCard Header="Device fingerprint"
                                           Description="Your other devices show this in a pairing request from this PC. Check it matches before accepting there.">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE928;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:Name="FingerprintText" Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True" />
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="TailscaleCard" Header="Tailscale address" Visibility="Collapsed">
                        <controls:SettingsCard.HeaderIcon>
                            <SymbolIcon Symbol="World" />
                        </controls:SettingsCard.HeaderIcon>
                        <Button Content="Copy" MinWidth="88" AutomationProperties.Name="Copy Tailscale address" Click="CopyTailscale_Click" />
                    </controls:SettingsCard>

                    <!-- Pairing (the phones' "Shared passcode") -->
                    <TextBlock Text="Pairing" Style="{StaticResource SectionHeader}" />
                    <controls:SettingsCard x:Name="PasscodeCard" Header="Passcode">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE72E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PasswordBox x:Name="PasscodeBox" Width="200"
                                         PlaceholderText="New passcode"
                                         AutomationProperties.Name="New passcode"
                                         KeyDown="PasscodeBox_KeyDown" />
                            <Button x:Name="SetPasscodeButton" Content="Set" Style="{StaticResource AccentButtonStyle}" MinWidth="72"
                                    Click="SetPasscode_Click" />
                            <Button x:Name="ClearPasscodeButton" Content="Clear" MinWidth="72" Click="ClearPasscode_Click" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <StackPanel x:Name="PasscodeBusy" Orientation="Horizontal" Spacing="8" Margin="1,4,0,4" Visibility="Collapsed">
                        <ProgressRing IsActive="True" Width="16" Height="16" />
                        <TextBlock Text="Saving the passcode..." Style="{StaticResource CaptionSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="PasscodeError" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Margin="1,4,0,4" Visibility="Collapsed" />

                    <!-- General -->
                    <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
                    <controls:SettingsCard Header="Start ClipLink when I sign in"
                                           Description="It starts in the notification area, so your devices stay in sync.">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="SignInToggle" OnContent="On" OffContent="Off"
                                      AutomationProperties.Name="Start ClipLink when I sign in"
                                      Toggled="SignInToggle_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="ShareMenuCard" Header="Show 'Share to ClipLink' in File Explorer">
                        <controls:SettingsCard.HeaderIcon>
                            <SymbolIcon Symbol="Share" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="ShareMenuToggle" OnContent="On" OffContent="Off"
                                      AutomationProperties.Name="Show Share to ClipLink in File Explorer"
                                      Toggled="ShareMenuToggle_Toggled" />
                    </controls:SettingsCard>

                    <!-- Synced history -->
                    <TextBlock Text="Synced history" Style="{StaticResource SectionHeader}" />
                    <controls:SettingsCard Header="Clear synced history"
                                           Description="Deletes every synced item from this PC. They won't come back from your other devices, which keep their own copies.">
                        <controls:SettingsCard.HeaderIcon>
                            <SymbolIcon Symbol="Delete" />
                        </controls:SettingsCard.HeaderIcon>
                        <Button Content="Clear" MinWidth="88" AutomationProperties.Name="Clear synced history"
                                Click="ClearHistory_Click" />
                    </controls:SettingsCard>

                    <!-- About -->
                    <TextBlock Text="About" Style="{StaticResource SectionHeader}" />
                    <controls:SettingsCard x:Name="AboutCard" Header="ClipLink">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE946;" />
                        </controls:SettingsCard.HeaderIcon>
                        <Button Content="Open log folder" Click="OpenLogs_Click" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Quit ClipLink"
                                           Description="Stops syncing until ClipLink starts again. Closing the window keeps it running in the notification area.">
                        <controls:SettingsCard.HeaderIcon>
                            <SymbolIcon Symbol="Cancel" />
                        </controls:SettingsCard.HeaderIcon>
                        <Button Content="Quit" MinWidth="88" AutomationProperties.Name="Quit ClipLink" Click="Quit_Click" />
                    </controls:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
