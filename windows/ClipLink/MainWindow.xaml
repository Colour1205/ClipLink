<ui:FluentWindow x:Class="ClipLink.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:ClipLink"
                 Title="ClipLink"
                 Width="960" Height="680"
                 MinWidth="560" MinHeight="480"
                 Icon="pack://application:,,,/ClipLink.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 FontFamily="{DynamicResource ContentControlThemeFontFamily}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="ClipLink">
            <ui:TitleBar.Icon>
                <ui:ImageIcon x:Name="TitleBarIcon" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Three destinations: LeftFluent (icons over labels), Settings in
             the footer - the mobile apps' tabs. NavigationCacheMode
             Required: each page is made once and kept (they subscribe to
             EngineHost in their constructors). -->
        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="LeftFluent"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Synced"
                                       Icon="{ui:SymbolIcon ClipboardPaste24}"
                                       TargetPageType="{x:Type local:SyncedPage}"
                                       NavigationCacheMode="Required" />
                <ui:NavigationViewItem Content="Devices"
                                       Icon="{ui:SymbolIcon PhoneLaptop24}"
                                       TargetPageType="{x:Type local:DevicesPage}"
                                       NavigationCacheMode="Required" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type local:SettingsPage}"
                                       NavigationCacheMode="Required" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- "Copied", "Saved"... at the bottom of the content, centred
             under it - not stretched across a wide window. -->
        <ui:SnackbarPresenter x:Name="Snackbars" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                              MaxWidth="600" Margin="96,0,24,16" />

        <!-- In-window dialogs: pairing requests and confirmations. -->
        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
