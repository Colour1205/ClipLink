<Page x:Class="ClipLink.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:ClipLink"
      Title="Devices"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{DynamicResource ContentControlThemeFontFamily}"
      ScrollViewer.CanContentScroll="False">
    <!-- CanContentScroll False: NavigationView doesn't wrap the page in a
         ScrollViewer of its own - the header stays put and only the
         content below it scrolls. -->
    <Page.Resources>
        <!-- One device: name, then status and addresses; full id on hover. -->
        <DataTemplate x:Key="DeviceTemplate" DataType="{x:Type local:DeviceRow}">
            <Border Style="{StaticResource Card}"
                    Padding="16,12,12,12"
                    Margin="0,0,0,4"
                    AutomationProperties.Name="{Binding AutomationName}">
                <!-- The full id (one long word): wrapped, not cut off. -->
                <Border.ToolTip>
                    <ToolTip>
                        <TextBlock Text="{Binding IdToolTip}" TextWrapping="Wrap" MaxWidth="360" />
                    </ToolTip>
                </Border.ToolTip>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy device ID" Icon="{ui:SymbolIcon Copy24}" Click="CopyId_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="40" Height="40" VerticalAlignment="Center">
                        <Border CornerRadius="20" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <ui:SymbolIcon Symbol="PhoneLaptop24" FontSize="20" />
                        </Border>
                        <!-- Connected: a green dot on the icon. -->
                        <Ellipse Width="12" Height="12"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                 Stroke="{DynamicResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="2"
                                 Visibility="{Binding Connected, Converter={StaticResource VisibleIf}}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Copy24}"
                                   ToolTip="Copy device ID" AutomationProperties.Name="Copy device ID"
                                   Click="CopyId_Click" />
                        <ui:Button Content="Remove" MinWidth="88" Margin="8,0,0,0"
                                   Visibility="{Binding Trusted, Converter={StaticResource VisibleIf}}"
                                   AutomationProperties.Name="{Binding Title, StringFormat=Remove {0}}"
                                   Click="Remove_Click" />
                        <ui:Button Content="Trust" MinWidth="88" Margin="8,0,0,0" Appearance="Primary"
                                   Visibility="{Binding Trusted, Converter={StaticResource VisibleIfNot}}"
                                   AutomationProperties.Name="{Binding Title, StringFormat=Trust {0}}"
                                   Click="Trust_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="36,12,36,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMaxWidth}" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ListTitle" Text="Devices" Style="{StaticResource TitleText}" />
                    <!-- In the pairing view: "Devices > Add a device", Devices going back. -->
                    <StackPanel x:Name="PairTitle" Orientation="Horizontal" Visibility="Collapsed">
                        <ui:Button x:Name="BackToList"
                                   Appearance="Transparent" BorderThickness="0"
                                   Padding="4,0,4,2" Margin="-4,0,0,0"
                                   ToolTip="Back to Devices"
                                   AutomationProperties.Name="Back to Devices"
                                   Click="BackToList_Click">
                            <TextBlock Text="Devices" Style="{StaticResource TitleText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </ui:Button>
                        <ui:SymbolIcon Symbol="ChevronRight20" FontSize="16" Margin="8,4,8,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Add a device" Style="{StaticResource TitleText}" />
                    </StackPanel>
                    <ui:Button x:Name="AddDeviceButton" Grid.Column="1"
                               Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Add device"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Click="AddDevice_Click" />
                </Grid>
                <local:Banner x:Name="StatusBanner" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>

        <!-- The device list -->
        <ScrollViewer x:Name="DeviceList" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="36,0,36,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMaxWidth}" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Visibility="{Binding HasPairedDevices, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="Paired devices" Style="{StaticResource SectionHeaderText}" Margin="1,12,0,8" />
                        <ItemsControl ItemsSource="{Binding PairedDevices}" ItemTemplate="{StaticResource DeviceTemplate}" Focusable="False" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasNearbyDevices, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="On this network" Style="{StaticResource SectionHeaderText}" Margin="1,20,0,2" />
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="1,0,0,8"
                                   Text="Not paired with this PC. Trust one to sync with it once it trusts this PC too, or use Add device to pair both at once." />
                        <ItemsControl ItemsSource="{Binding NearbyDevices}" ItemTemplate="{StaticResource DeviceTemplate}" Focusable="False" />
                    </StackPanel>

                    <!-- Nothing paired or nearby. -->
                    <StackPanel Visibility="{Binding HasNoDevices, Converter={StaticResource VisibleIf}}"
                                HorizontalAlignment="Center" MaxWidth="380" Margin="0,56,0,0">
                        <ui:SymbolIcon Symbol="PhoneLaptop24" FontSize="48" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No devices yet" Style="{StaticResource SubtitleText}"
                                   HorizontalAlignment="Center" Margin="0,16,0,4" />
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Devices running ClipLink on this network show up here. Select Add device to pair one." />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Pairing: open only while this is showing. -->
        <ScrollViewer x:Name="PairView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="36,0,36,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMaxWidth}" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <local:Banner Severity="Informational"
                                  Title="Pairing is on while this page is open."
                                  Message="Open the pairing screen on your other device too. Each device asks you to accept the other - nothing is trusted until both do."
                                  Margin="0,12,0,0" />

                    <TextBlock Text="Scan with your phone" Style="{StaticResource SectionHeaderText}" />
                    <Border x:Name="QrCard" Style="{StaticResource Card}" Padding="16">
                        <Grid x:Name="QrLayout">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Always dark on white, whatever the theme - scanners expect it. -->
                            <Border Width="184" Height="184" CornerRadius="8" Background="White" Padding="6"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Grid>
                                    <Image x:Name="QrImage" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           AutomationProperties.Name="Pairing QR code" />
                                    <ui:ProgressRing x:Name="QrProgress" IsIndeterminate="True" Width="32" Height="32" />
                                </Grid>
                            </Border>
                            <StackPanel x:Name="QrText" Grid.Column="1" Margin="24,4,0,0" VerticalAlignment="Top">
                                <TextBlock x:Name="PairingName" Style="{StaticResource SubtitleText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="In ClipLink on your phone, open Pair and scan this code. It holds this PC's device ID, its name and its Tailscale address, if it has one." />
                                <ui:Button x:Name="CopyPairingButton" Content="Copy pairing info" Icon="{ui:SymbolIcon Copy24}"
                                           Margin="0,16,0,0" IsEnabled="False" Click="CopyPairingInfo_Click" />
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="For a device that can't scan: paste it there under Pair by address." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Pair by address" Style="{StaticResource SectionHeaderText}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                       Text="If the two can't find each other - on another network, or over Tailscale - enter the other device's IP address or paste its pairing info." />
                            <!-- What to type on the other device instead (the
                                 phones show theirs on their Me screen). -->
                            <TextBlock x:Name="OwnAddresses" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Margin="0,4,0,0" Visibility="Collapsed" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="AddressBox"
                                            PlaceholderText="For example 192.168.1.20 or 100.101.102.103"
                                            Icon="{ui:SymbolIcon Link24}"
                                            AutomationProperties.Name="Address or pairing info"
                                            KeyDown="AddressBox_KeyDown" />
                                <ui:Button x:Name="ConnectButton" Grid.Column="1" Appearance="Primary" Content="Connect"
                                           MinWidth="96" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                           Click="Connect_Click" />
                            </Grid>
                            <StackPanel x:Name="Connecting" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" />
                                <TextBlock Style="{StaticResource BodyText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Text="Connecting... this can take up to 20 seconds." />
                            </StackPanel>
                            <ui:InfoBar x:Name="PairResult" IsOpen="False" IsClosable="True" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="1,16,0,0"
                               Text="Devices on the same network pair by themselves while both have this screen open - the code and the address are only for when they can't find each other." />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
