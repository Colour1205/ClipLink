<Project Sdk="Microsoft.NET.Sdk">

  <!-- ClipLink.exe, the Windows app, in WinUI 3 (Windows App SDK): Mica, the
       native Fluent controls and DirectManipulation touchpad scrolling. The
       sync engine (Engine\, ClipLinkEngine) is part of it and runs in-process.
       Unpackaged and self-contained: `dotnet build` for development;
       ..\publish.ps1 makes the app folder and the installer. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClipLink</AssemblyName>
    <RootNamespace>ClipLink</RootNamespace>
    <Product>ClipLink</Product>
    <Version>2.3.0</Version>
    <ApplicationIcon>..\ClipLink.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.Main is the entry point (the single-instance check runs
         before WinUI starts). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Published precompiled (ReadyToRun), so a start - every sign-in - JITs
         less: ClipLink.dll, the WinRT runtime, the toolkits, the tray icon's
         and the notifications' libraries. Measured on a test copy: the engine
         is up about 14% sooner, with about 13% less CPU, for about 1.4 MB more
         installer. Not the big projections and libraries listed below: most
         of their code never runs, and precompiled they'd be about twice the
         size (all of them too: some 2.3 MB more installer to start about
         25 ms sooner). -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
    <PublishReadyToRunExclude Include="Microsoft.WinUI.dll" />
    <PublishReadyToRunExclude Include="Microsoft.InteractiveExperiences.Projection.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Web.WebView2.Core.Projection.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Windows.Management.Deployment.Projection.dll" />
    <PublishReadyToRunExclude Include="System.Numerics.Tensors.dll" />
    <PublishReadyToRunExclude Include="QRCoder.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- Parts of the Windows App SDK that ClipLink never calls: their native
         libraries (onnxruntime, DirectML...) would add about 40 MB to every
         install. Listed here to leave their files out. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.5.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.94" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.5.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" ExcludeAssets="all" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <!-- Toast notifications with buttons (a pairing request's Trust / Ignore) for
         an unpackaged, self-contained app: see PairingNotifications.cs for why
         not the Windows App SDK's own. -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- What ClipLink used from the Windows desktop framework besides
         WinForms (see below), as the same assemblies from NuGet: the tray
         icon (System.Drawing, which H.NotifyIcon also needs) and the
         clipboard watcher's picture decoding, signing out
         (SystemEvents.SessionEnding) and DPAPI for the keys at rest. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one icon, shared with the rest of windows/ (linked, not copied),
         next to the exe: the tray and title bar load it from there. -->
    <Content Include="..\ClipLink.ico" Link="ClipLink.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- No WinForms: the clipboard watcher uses the Win32 clipboard directly
       (Engine\Clipboard\Win32Clipboard.cs). The WindowsForms framework
       reference it had put about 30 MB of WinForms assemblies (some 8 MB of
       the installer) in every install for that one class. -->

</Project>
