<Project Sdk="Microsoft.NET.Sdk">

  <!-- ClipLink.exe, the Windows app, in WinUI 3 (Windows App SDK): Mica, the
       native Fluent controls and DirectManipulation touchpad scrolling. The
       sync engine (Engine\, ClipLinkEngine) is part of it and runs in-process.
       Unpackaged and self-contained: `dotnet build` for development;
       ..\publish.ps1 makes the app folder and the installer. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClipLink</AssemblyName>
    <RootNamespace>ClipLink</RootNamespace>
    <Product>ClipLink</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\ClipLink.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.Main is the entry point (the single-instance check runs
         before WinUI starts). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- Parts of the Windows App SDK that ClipLink never calls: their native
         libraries (onnxruntime, DirectML...) would add about 40 MB to every
         install. Listed here to leave their files out. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.5.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.94" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.5.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" ExcludeAssets="all" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one icon, shared with the rest of windows/ (linked, not copied),
         next to the exe: the tray and title bar load it from there. -->
    <Content Include="..\ClipLink.ico" Link="ClipLink.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- The engine's clipboard watcher is WinForms (an STA message loop and
         DataObject). Referenced as a framework, not with UseWindowsForms:
         that also pulls in WPF's XAML compiler, which fights WinUI's. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

</Project>
