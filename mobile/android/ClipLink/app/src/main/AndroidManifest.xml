<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the Me screen follow network changes (ConnectivityManager
         network callback) so its address list doesn't go stale. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- targetSdk 37 enforces Local Network Protections: WITHOUT this
         runtime permission every single thing this app does on the LAN
         fails - the UDP beacon's sendto returns EPERM, incoming beacons
         never arrive, and TCP dials to 192.168.x.x/100.64.x.x just time
         out (they do NOT report a permission error, which is why a denial
         looks exactly like "the peer is offline"). It is a NEARBY_DEVICES
         group runtime permission, so it has to be requested, not just
         declared. Apps targeting SDK 36 or lower must NOT declare it -
         local network access is implicit in INTERNET there. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Held while discovery is running. Also the runtime prerequisite for
         a connectedDevice foreground service: that type requires the app to
         hold at least one of CHANGE_NETWORK_STATE / CHANGE_WIFI_STATE /
         CHANGE_WIFI_MULTICAST_STATE (etc.) or startForeground throws. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- connectedDevice, NOT dataSync. dataSync is capped at 6 hours per
         24 and then hard-crashes the app via RemoteServiceException if it
         doesn't stop itself; connectedDevice is documented for "interactions
         with external devices ... or network connections" and carries no
         time limit at all, which is the only thing that makes a
         stay-reachable clipboard link viable. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- For PairScreen's QR scanner. Requested at runtime only when the user
         actually taps "Scan a Device's Code" (not eagerly at launch, like
         the network permissions above) - pairing works fine without it via
         "Pair by address", so there's no reason to ask upfront. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".ClipLinkApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipLink">

        <!-- singleTask: a pairing link that arrives while ClipLink is already
             running goes to that window (onNewIntent) instead of stacking a
             second one on top. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ClipLink">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The pairing QR code is a link to https://cliplink.uaena.io/pair/ (see
                 net/PairingLink.kt). With ClipLink installed, a phone's camera or
                 scanner app opens it here; without, the website opens. autoVerify:
                 the site's /.well-known/assetlinks.json names this app and the
                 certificate that signs it, and Android then opens the link here
                 without asking. The certificate listed there must be the one the
                 installed build is signed with: add the release key's SHA-256 to
                 site/.well-known/assetlinks.json before publishing a release. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="cliplink.uaena.io"
                    android:pathPrefix="/pair" />
            </intent-filter>
        </activity>

        <!-- "Share to ClipLink". Android 10+ forbids reading the clipboard
             outside the foreground/default-IME, so sharing into ClipLink is
             the real escape hatch for pushing something from another app
             without switching to this one first and tapping paste.

             Its own activity, not MainActivity: it copies what was shared,
             toasts and finishes, never showing the app. Translucent, out of
             recents and history, and in a task of its own (empty affinity)
             if the sender asks for a new one - with ClipLink's affinity it
             would bring ClipLink's task forward and leave the user there.
             It handles configuration changes itself because a recreation
             mid-copy would lose the share.

             */* covers text/plain and image/* too. SEND_MULTIPLE is what a
             gallery or file manager sends for more than one item. -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Theme.ClipLink.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- The Trust and Ignore buttons on a pairing notification. Not
             exported: only this app's own PendingIntents may reach it. -->
        <receiver
            android:name=".service.PairingActionReceiver"
            android:exported="false" />

        <service
            android:name=".service.ClipLinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
