<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- The ONLY thing FileProvider serves: human-named copies handed to other
         apps, as a content:// URI (a file:// URI would throw
         FileUriExposedException the moment it left this process). A blob is
         stored under its hash, which is useless in a share sheet, so
         ClipboardBridge.contentUriFor puts a copy named like the file under
         shared/ and shares that (stale ones are pruned, see
         ClipboardBridge.pruneSharedCopies). The blob store itself
         (files/cliplink_files) is deliberately NOT exposed here. -->
    <cache-path name="shared" path="shared/" />
</paths>
