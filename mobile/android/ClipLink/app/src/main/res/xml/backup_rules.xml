<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup (Android 11 and older; Android 12+ reads data_extraction_rules.xml).

    NOTHING of this app is backed up. android:allowBackup is "false" in the
    manifest, and this file says the same in case that flag is ever flipped:
    what is stored here is the synced history (clipboard text and images, which
    can be passwords), the passcode's derived key, the trust store and the
    clipboard hash. The device identity itself lives in the Android Keystore and
    does NOT come back on a restore, so a restored phone would get a new
    identity next to the old trust records and pair with nobody, silently -
    while its history sat in a cloud backup for no reason.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
