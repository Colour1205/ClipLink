<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and device-transfer rules. Same as backup_rules.xml:
    NOTHING is backed up or transferred. The history, the passcode key, the
    trust store and the clipboard hash must not leave this phone, and the
    Keystore identity would not follow them anyway (see backup_rules.xml).
    android:allowBackup is "false" in the manifest; this holds even if it is
    ever turned on.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
