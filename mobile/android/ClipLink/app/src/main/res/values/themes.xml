<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Everything visual is decided in Compose (see ui/theme/Theme.kt) -
         this platform theme only exists to give the window itself sane
         defaults before the first frame: no action bar, and fully
         transparent system bars so enableEdgeToEdge()'s content can draw
         all the way behind them. Deliberately NOT a Material Components
         theme: those views aren't used at all, and inheriting one would
         drag AppCompat back in for nothing. -->
    <style name="Theme.ClipLink" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>

    <!-- ShareReceiverActivity: no window of its own to speak of. The app it
         was shared from stays in view underneath; Compose only draws a small
         progress card if a copy takes a while. No open/close animation, so
         a quick share doesn't even flicker. -->
    <style name="Theme.ClipLink.Share" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
