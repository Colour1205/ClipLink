{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // Per uiMaterial's own reference doc: in the default mode, Navigation/
    // NavDestination title bars do NOT get immersive material
    // automatically - only specific popup/dialog components do. "enable"
    // turns it on by default for Navigation/NavDestination (among others)
    // so their native title bar and back button get the effect without
    // any manual systemMaterial() call on custom-built replacement
    // widgets - the native rendering handles correct positioning/safe-area
    // clearance for free, which repeated attempts at a custom title
    // builder could not reliably reproduce.
    "metadata": [
      {
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      }
    ],
    "requestPermissions": [
      {
        // Restricted (ACL): approved by Huawei on 2026-10-12, used only while
        // the app is in use (usedScene.when "inuse"), by EntryAbility, which
        // reads the clipboard when ClipLink comes forward (Index.ets's
        // captureOnOpen). Without a signing profile that carries the ACL this
        // line makes the app uninstallable - DevEco's "ACL Permission
        // Configuration" dialog (Abilities: EntryAbility) writes both.
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:READ_PASTEBOARD_reason",
        "usedScene": {
          "when": "inuse",
          "abilities": [
            "EntryAbility"
          ]
        }
      },
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        // Normal/system_grant permission (confirmed against the official
        // permission reference): no ACL/AppGallery restricted-permission
        // process, no runtime user dialog. Needed for the long-press menu's
        // hapticFeedbackMode - see syncedItemCard's bindContextMenu.
        "name": "ohos.permission.VIBRATE"
      },
      {
        // Normal/system_grant. Lets the Me screen list this device's own
        // IP addresses (connection.getConnectionPropertiesSync).
        "name": "ohos.permission.GET_NETWORK_INFO"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // Follow the sensor, but not the user's rotation lock. Left out, a
        // phone stays upright (a tablet turned anyway) - and the app is laid
        // out for both: under 600vp wide it is one column, wider it is the
        // list-and-detail split (see the README's Tablets and wide windows).
        "orientation": "auto_rotation_restricted",
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            // "Share to ClipLink" in the system share panel - see
            // share/ShareIntake.ets. A skill of its own (one action per
            // skill is Huawei's advice). maxFileSupported defaults to 0,
            // which means "not accepted", so each type states its limit.
            // general.object is the catch-all Huawei's docs name;
            // general.file too, since a file with an unknown extension
            // gets a "flex." type that may not descend from general.object.
            // "scheme" does nothing here, but the SDK schema requires it
            // next to "utd" (the build fails without it).
            "actions": [
              "ohos.want.action.sendData"
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.object",
                "maxFileSupported": 50
              },
              {
                "scheme": "file",
                "utd": "general.file",
                "maxFileSupported": 50
              }
            ]
          },
          {
            // The pairing QR code is a link to https://cliplink.uaena.io/pair/ (see
            // networking/PairingLink.ets). With ClipLink installed the system
            // scanner opens it here (App Linking); without, the website opens.
            // domainVerify: the site's /.well-known/applinking.json names this
            // app by its appIdentifier (AppGallery Connect > the app > App
            // information; `bm dump -n io.uaena.cliplink` shows it for an
            // installed build). pathStartWith covers /pair and /pair/.
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "https",
                "host": "cliplink.uaena.io",
                "pathStartWith": "pair"
              }
            ],
            "domainVerify": true
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ]
  }
}